location /assets/ {
    alias /var/www/html/assets/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public";
}

location / {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
    fastcgi_param SCRIPT_NAME /index.php;
    fastcgi_param PATH_INFO $uri;
    fastcgi_param QUERY_STRING $query_string;
    fastcgi_pass tarawiki-mediawiki:9000;
}

location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp)$ {
    try_files $uri /index.php?$query_string;
    expires max;
    log_not_found off;
}

location ~ ^/(cache|deleted|maintenance|languages|serialized)/ {
    deny all;
}

location ~ /(LocalSettings\.php|AdminSettings\.php) {
    deny all;
}

location ~ \.php$ {
    access_log /var/log/nginx/php-access.log;
    error_log  /var/log/nginx/php-error.log;

    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
    fastcgi_index index.php;
    fastcgi_pass tarawiki-mediawiki:9000;

    fastcgi_keep_conn on;

    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;
    fastcgi_busy_buffers_size 64k;
    fastcgi_read_timeout 300s;
    fastcgi_send_timeout 300s;

    fastcgi_cache fastcgi;
    fastcgi_cache_key "$scheme$request_method$host$request_uri";
    fastcgi_cache_valid 200 60m;
    fastcgi_cache_bypass $http_pragma $http_authorization $cookie_wikiUserID $cookie_wikiUserName;
    fastcgi_no_cache $http_pragma $http_authorization $cookie_wikiUserID $cookie_wikiUserName;
}
